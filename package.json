{
  "name": "socia",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,api -c blue,cyan \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "npm run dev --workspace=@socia/web",
    "dev:api": "npm run dev --workspace=@socia/api",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "start": "npm run start --workspace=@socia/web"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
